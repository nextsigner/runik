####### Install

install_assets: first FORCE
	@test -d $(INSTALL_ROOT)/assets || mkdir -p $(INSTALL_ROOT)/assets
	$(QINSTALL) /home/ns/nsp/runik/android/assets/ephe $(INSTALL_ROOT)/assets/ephe
	$(QINSTALL) /home/ns/nsp/runik/android/assets/imgs $(INSTALL_ROOT)/assets/imgs

uninstall_assets: FORCE
	-$(DEL_FILE) -r $(INSTALL_ROOT)/assets/imgs
	-$(DEL_FILE) -r $(INSTALL_ROOT)/assets/ephe
	-$(DEL_DIR) $(INSTALL_ROOT)/assets/ 


install_target: first FORCE
	@test -d $(INSTALL_ROOT)/libs/arm64-v8a/ || mkdir -p $(INSTALL_ROOT)/libs/arm64-v8a/
	$(QINSTALL_PROGRAM) ../../bin/$(QMAKE_TARGET) $(INSTALL_ROOT)/libs/arm64-v8a/$(QMAKE_TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) $(INSTALL_ROOT)/libs/arm64-v8a/$(QMAKE_TARGET)
	-$(DEL_DIR) $(INSTALL_ROOT)/libs/arm64-v8a/ 


install: install_assets install_target  FORCE

uninstall: uninstall_assets uninstall_target  FORCE

FORCE:

.SUFFIXES:

